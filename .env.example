# ==============================================================================
# ODONTOMÓVEL - MODELO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie este arquivo para .env na sua VPS e preencha com as credenciais reais.
# ==============================================================================

# --- SERVIDOR / VPS ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# --- VARIÁVEIS DO FRONTEND (Vite) ---
VITE_APP_NAME="OdontoMóvel"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="production"
VITE_APP_URL="https://seu-dominio.com.br"
VITE_API_BASE_URL="/api"
VITE_STORAGE_PREFIX="odontomovel_prod_"
VITE_ORGANIZATION_NAME="OdontoMóvel Gestão de Frotas Odontológicas"
VITE_DEFAULT_STATE="SP"

# --- BANCO DE DADOS NA VPS ---
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=informe_sua_senha
DB_NAME=odontomovel_db
DATABASE_URL=postgresql://postgres:informe_sua_senha@127.0.0.1:5432/odontomovel_db

# --- AUTENTICAÇÃO & SEGURANÇA ---
JWT_SECRET=gerar_uma_chave_segura_de_64_caracteres
JWT_EXPIRES_IN=7d

# --- ARMAZENAMENTO DE ANEXOS ---
STORAGE_DRIVER=local
UPLOAD_DIR=/var/www/odontomovel/uploads
